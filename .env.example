# Copy to .env (never commit .env). Values used by docker-compose.yml.
POSTGRES_DB=p4
POSTGRES_USER=p4
POSTGRES_PASSWORD=change-me
# HS256 needs at least 32 bytes. Generate one: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
APP_JWT_EXPIRATION_MINUTES=60
FE_PORT=4200
